[Unit]
Description=ZoneMinder API Service
Documentation=https://github.com/ZoneMinder/zoneminder
# Ordered after a local database if one is present, but deliberately not
# dependent on it: a hard Requires=mariadb.service fails the start outright on
# hosts using mysql.service or a remote database. Restart=on-failure covers a
# database that is merely slow to come up.
After=network-online.target mariadb.service mysql.service
Wants=network-online.target

[Service]
Type=simple
# The account is set per host by a drop-in,
# /etc/systemd/system/zm-api.service.d/10-account.conf, which the package's
# post-install step (/usr/share/zm-api/setup-instance.sh) writes: zm-api runs
# as the account ZoneMinder runs as, ZM_WEB_USER in /etc/zm/zm.conf. That is
# www-data on Debian and Ubuntu, apache on the Red Hat family, wwwrun on
# openSUSE and http on Arch, so no single name here could be right.
#
# The values below are the fallback for a host with no ZoneMinder, where the
# same script creates a dedicated `zoneminder` account. To run as something
# else, add a drop-in that sorts after 10-account.conf (systemctl edit zm-api).
#
# Extra groups (video, ssl-cert, ZoneMinder's ZM_STREAM_SOCKET_GROUP) are in
# the drop-in as well, and only the ones this host has: naming a group that
# does not exist makes systemd refuse to start the unit (status=216/GROUP).
# Live streaming needs the stream-socket group. Without it streams fail and
# the log reports "permission denied opening stream socket ...".
User=zoneminder
Group=zoneminder

# Environment configuration
EnvironmentFile=-/etc/zm-api/zm-api.env

# Paths. ZoneMinder's share directory is absent on a host without ZoneMinder,
# hence the "-": a missing working directory is otherwise a start failure.
WorkingDirectory=-/usr/share/zoneminder
# systemd creates both and re-owns them to the unit's account on every start,
# so they follow an account change without a manual chown.
StateDirectory=zm-api
LogsDirectory=zm-api

# ZoneMinder's socket directory (zmdc.sock, zm.pid, the per-monitor stream
# sockets) belongs to its package. It must NOT be declared as RuntimeDirectory
# here: systemd would chown it to this unit's user on start and delete it on
# every stop/restart, which in passive mode unlinks zmdc.pl's listening socket
# and zmc's stream sockets from under a running ZoneMinder (#82). Create it
# only when it is missing, and never touch an existing one. The drop-in
# replaces this line with the host's account and its ZM_PATH_SOCKS.
ExecStartPre=+/bin/sh -c 'test -d /run/zm || install -d -m 0755 -o zoneminder -g zoneminder /run/zm'

# Execution
ExecStart=/usr/bin/zm-api
ExecReload=/bin/kill -HUP $MAINPID

# Graceful shutdown. The HTTP drain and the daemon SIGTERM wave run
# concurrently, each bounded by shutdown_timeout_seconds (30s), with the
# SIGKILL escalation after it; leave margin so systemd never SIGKILLs a zmc
# that was mid-SIGTERM.
KillSignal=SIGTERM
TimeoutStopSec=50
KillMode=mixed

# Restart policy
Restart=on-failure
RestartSec=5

# Resource limits
LimitNOFILE=65535

# Security hardening (relaxed for daemon control)
NoNewPrivileges=no
PrivateTmp=no
ProtectSystem=full
ProtectHome=read-only

# Allow binding to privileged ports if needed
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_KILL CAP_SYS_PTRACE

[Install]
WantedBy=multi-user.target
