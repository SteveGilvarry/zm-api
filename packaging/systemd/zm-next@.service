# One zm-next worker (zm-core) per zm-next monitor: zm-next@<monitor id>.service.
#
# zm-api starts and stops these instances; they are deliberately NOT part of
# zm-api.service, so restarting or upgrading zm-api leaves recording running
# and zm-api reconnects to the worker's socket when it comes back. zm-api
# supervises them itself (Restart=no here), and a polkit rule
# (50-zm-api-zm-next.rules) lets its service user start/stop only these units.
#
# zm-api writes /run/zm-api/zm-next/<id>.env before each start. It names the
# binary, its directory (plugins load relative to it) and the arguments; the
# pipeline file it points to holds camera credentials and is mode 0600.
[Unit]
Description=zm-next worker for monitor %i
Documentation=https://github.com/SteveGilvarry/zm-api
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=zoneminder
Group=zoneminder
SupplementaryGroups=video
EnvironmentFile=/run/zm-api/zm-next/%i.env
ExecStart=/bin/sh -c 'cd "$ZMNEXT_DIR" && exec "$ZMNEXT_BIN" $ZMNEXT_ARGS'
KillMode=control-group
KillSignal=SIGTERM
TimeoutStopSec=15
Restart=no
LimitNOFILE=65535
NoNewPrivileges=yes
PrivateTmp=no
ProtectSystem=full
ProtectHome=read-only

[Install]
# Not enabled at boot: zm-api starts the workers its monitors need.
