#!/bin/sh
# Debian postrm for zm-api.
set -e

case "$1" in
  remove)
    if [ -d /run/systemd/system ]; then
      systemctl daemon-reload || true
    fi
    ;;
  purge)
    # Remove generated state (JWT keys), logs, and the account drop-in that
    # setup-instance.sh wrote. No account is removed: the service ran as
    # ZoneMinder's own, or as a `zoneminder` account ZoneMinder may now use.
    rm -rf /var/lib/zm-api /var/log/zm-api
    rm -f /etc/systemd/system/zm-api.service.d/10-account.conf
    rmdir /etc/systemd/system/zm-api.service.d 2>/dev/null || true
    if [ -d /run/systemd/system ]; then
      systemctl daemon-reload || true
    fi
    ;;
  upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
    ;;
esac

exit 0
